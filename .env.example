# Supabase (optional). Leave BOTH blank to run in local-only demo mode
# (data stays in the browser's localStorage, no account needed).
#
# Fill both in to enable accounts + cloud sync across devices. Copy this file to
# .env.local and paste your project's values (Supabase dashboard → Project
# Settings → API). Only the public anon key belongs here — never the service role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
